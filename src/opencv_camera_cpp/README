source /opt/ros/humble/setup.bash 

 

 

BUILD 

cd ~/ros2_ws 

colcon build --symlink-install 

source install/setup.bash 

 

RUN  

source install/setup.bash 

ros2 run opencv_camera_cpp camera_node 

 

TEST PUBLISHER 

source install/setup.bash 

ros2 run opencv_camera_cpp bottle_publisher 

ros2 run opencv_camera_cpp bottle_test_publisher 

 

REAL SENSE 

source install/setup.bash 

ros2 launch realsense2_camera rs_launch.py 

 

 

MISSION CONTROL GUI 

source install/setup.bash 

ros2 run opencv_camera_cpp mission_control_gui 

 

 

LAUNCH  

source install/setup.bash 

ros2 launch opencv_camera_cpp mission_control.launch.py 

 

 