# Navigate to workspace root
cd ~/ros2_ws

# Build
colcon build --symlink-install --packages-select bottle_detector

# Source the workspace
source install/setup.bash

# Run SVM Trainer:
ros2 run bottle_detector svm_trainer

# Run SVM Node:
ros2 run bottle_detector svm_node

# ---------------------------------------------------------------------------------
# Testing SVM Node Predictions
# ---------------------------------------------------------------------------------

# Sprite (Recyclable): 
ros2 topic pub -1 /bottle_features std_msgs/msg/Float32MultiArray "{data: [135.0, 408.0, 82.5, 252.0, 132.0]}"

# Fanta (Non-Recyclable):
ros2 topic pub -1 /bottle_features std_msgs/msg/Float32MultiArray "{data: [195.0, 455.0, 12.5, 212.0, 132.0]}"

# Woolies Lemonade (Non-Recyclable):
ros2 topic pub -1 /bottle_features std_msgs/msg/Float32MultiArray "{data: [153.0, 458.0, 102.5, 204.0, 76.0]}"

# Coke No Sugar (Recyclable)
ros2 topic pub -1 /bottle_features std_msgs/msg/Float32MultiArray "{data: [154.0, 472.0, 2.5, 196.0, 124.0]}"

# ---------------------------------------------------------------------------------
# Checking is_recyclable publisher/topic
# ---------------------------------------------------------------------------------

ros2 topic echo /is_recyclable
# data: true (Recyclable)
# data: false (Non-Recyclable)